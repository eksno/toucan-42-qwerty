#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <185>;
            flavor = "tap-preferred";
            quick-tap-ms = <185>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // --- base-layer text combos. require-prior-idle-ms blocks misfires
        // during fast typing; layers = <0> keeps them off the other layers. ---
        caps {
            bindings = <&kp CAPS>;
            key-positions = <16 19>;   // F + J (index home keys)
            layers = <0>;
            require-prior-idle-ms = <125>;
        };

        under {
            bindings = <&kp UNDER>;
            key-positions = <28 31>;   // V + M
            layers = <0>;
            require-prior-idle-ms = <125>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <4 7>;     // R + U
            layers = <0>;
            require-prior-idle-ms = <125>;
        };

        // jk -> Esc (vim muscle memory).
        jk_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;   // J + K
            layers = <0>;
            require-prior-idle-ms = <125>;
        };

        // Left-hand cut/copy/paste (ported from the Corne): ring+middle finger
        // pairs across the three rows. Valuable here because the right half is the
        // Cirque trackpad — edit one-handed with the left while the right points.
        cut {
            bindings = <&kp LC(X)>;
            key-positions = <2 3>;     // W + E (top)
            layers = <0>;
            require-prior-idle-ms = <125>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <14 15>;   // S + D (home)
            layers = <0>;
            require-prior-idle-ms = <125>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <26 27>;   // X + C (bottom)
            layers = <0>;
            require-prior-idle-ms = <125>;
        };

        // ? on the two outer thumbs — far apart, never fires by accident.
        qmark {
            bindings = <&kp QUESTION>;
            key-positions = <36 41>;   // ESC thumb + GUI thumb
            layers = <0>;
            require-prior-idle-ms = <125>;
        };

        // --- Bluetooth controls: GATED behind deliberate cross-keyboard combos on
        // the spaces layer (hold an outer GUI/ESC thumb to reach it). These used to
        // be LONE keys on the nav thumbs (&bt BT_CLR / &bt BT_NXT) right where you
        // hold to navigate + point — a stray tap wiped the bond / switched profile.
        // Now a single tap can never touch BT. ---
        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <25 34>;   // Z + /  (bottom-row outer mirror)
            layers = <3>;
            require-prior-idle-ms = <150>;
            timeout-ms = <75>;
        };

        bt_next {
            bindings = <&bt BT_NXT>;
            key-positions = <1 10>;    // Q + P  (top-row outer mirror)
            layers = <3>;
            require-prior-idle-ms = <150>;
            timeout-ms = <75>;
        };

        // ZMK Studio unlock — lets the Studio app make LIVE keymap edits over USB
        // (the left build enables Studio). No-op when Studio isn't connected.
        studio {
            bindings = <&studio_unlock>;
            key-positions = <29 30>;   // B + N (the two inner bottom keys)
            layers = <3>;
            require-prior-idle-ms = <150>;
            timeout-ms = <75>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        home {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q            &kp W                &kp E                    &kp R                  &kp T        &kp Y        &kp U              &kp I             &kp O                 &kp P                    &kp BSPC
&kp LCTRL  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHIFT F  &kp G        &kp H        &hm RSHIFT J  &hm RCTRL K  &hm RALT L  &hm LGUI SEMICOLON  &kp SQT
&kp LSHFT  &kp Z            &kp X                &kp C                    &kp V                  &kp B        &kp N        &kp M              &kp COMMA         &kp PERIOD            &kp SLASH                &kp ESC
                                             &lt 3 ESCAPE             &lt 1 BACKSPACE        &lt 2 TAB    &lt 2 ENTER  &lt 1 SPACE        &lt 3 LGUI
            >;

            label = "home";
        };

        num {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL            &kp AT               &kp LEFT_BRACE              &kp RIGHT_BRACE                   &kp PIPE     &kp PLUS   &kp NUMBER_7  &kp N8        &kp N9                    &kp ASTERISK   &trans
&trans  &hm LGUI HASH  &hm LALT DOLLAR  &hm LCTRL LEFT_PARENTHESIS  &hm LSHIFT RIGHT_PARENTHESIS  &kp GRAVE    &kp MINUS  &hm RSHIFT NUMBER_4  &hm RCTRL NUMBER_5  &hm RALT NUMBER_6  &hm LGUI COLON  &trans
&trans  &kp PERCENT         &kp CARET            &kp LEFT_BRACKET            &kp RIGHT_BRACKET                 &kp TILDE    &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH  &trans
                                                &kp SLASH                   &kp QUESTION                      &kp DEL      &kp RET    &kp SPACE     &kp N0
            >;

            label = "num";
        };

        nav {
            bindings = <
&trans  &kp F1            &kp F2           &kp F3        &kp F4             &trans             &trans  &trans           &kp PG_DN       &kp PG_UP         &trans          &trans
&trans  &hm LGUI F5  &hm LALT F6  &hm LCTRL F7  &hm LSHIFT F8  &hm LC(V) LC(C)    &trans  &hm RSHIFT LEFT  &hm RCTRL DOWN  &hm RALT UP  &hm LGUI RIGHT  &trans
&trans  &kp F9            &kp F10          &kp F11       &kp F12            &kp PSCRN          &trans  &trans           &trans          &trans            &trans          &trans
                                           &trans        &trans             &trans             &trans  &trans     &trans
            >;

            label = "nav";
        };

        spaces {
            bindings = <
&trans  &trans     &trans     &trans     &trans          &trans       &trans     &trans     &trans     &trans     &trans     &trans
&trans  &kp LG(A)  &kp LG(S)  &kp LG(D)  &kp LG(F)       &kp LG(G)    &kp LG(G)  &kp LG(F)  &kp LG(D)  &kp LG(S)  &kp LG(A)  &trans
&trans  &trans     &trans     &trans     &kp LG(H)       &kp LG(J)    &kp LG(J)  &kp LG(H)  &trans     &trans     &trans     &trans
                              &trans     &kp LSHIFT      &trans       &trans     &kp LSHIFT &trans
            >;
        };
    };
};
